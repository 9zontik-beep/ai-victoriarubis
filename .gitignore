# Секреты — только на твоём компьютере, в репозиторий не попадают.
secrets/channel.env
secrets/*.env
!secrets/channel.env.example
*.token
*.key
*.pem

# Зависимости движка — ставятся командой bun install.
node_modules/
dist/
build/

# Рабочее состояние агента — создаётся при запуске.
# (Уже ловится dashi-plugin-claude-code/plugin/.gitignore -> /state/, anchored
# to that folder. Unanchored patterns here previously also matched
# src/state/ — real source code — and silently dropped it from the repo.)
update-offset
*.log

# Личная память агента — остаётся только у тебя (структуру храним, заметки нет).
core/memory/*
!core/memory/README.md
!core/memory/.gitkeep

# Прочее.
.DS_Store
# Только корневой .mcp.json (если появится) — плагину нужен свой,
# dashi-plugin-claude-code/plugin/.mcp.json, его не трогаем.
/.mcp.json

# Метка последнего «я вернулся» — локальное состояние, не для репозитория.
.claude/.last-startup-notice

# Напоминания владельцу и их журнал — личные данные, не для репозитория.
core/reminders.tsv
core/reminders.log

# Отметка «о выключенном стороже уже написал» — локальное состояние.
core/watchdog-keeper.state
